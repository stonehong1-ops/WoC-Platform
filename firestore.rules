rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isUserActive(uid) {
      let userDoc = get(/databases/$(database)/documents/users/$(uid)).data;
      return request.auth != null && 
             (!('accountStatus' in userDoc) || userDoc.accountStatus == 'active');
    }

    function hasBlockBetween(uid1, uid2) {
      return exists(/databases/$(database)/documents/users/$(uid1)/blockedUsers/$(uid2)) ||
             exists(/databases/$(database)/documents/users/$(uid2)/blockedUsers/$(uid1));
    }

    function isNotBlocked(authorId) {
      return request.auth == null || authorId == null || authorId == "" || 
             (
               !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blockedUsers/$(authorId)) &&
               !exists(/databases/$(database)/documents/users/$(authorId)/blockedUsers/$(request.auth.uid))
             );
    }


    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
      match /aiTryonPhotos/{photoId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /aiTryonResults/{resultId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /aiIdentityRefs/{photoId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      match /aiLessonThreads/{threadId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
        match /messages/{messageId} {
          allow read: if request.auth != null && request.auth.uid == userId;
          allow write: if request.auth != null && request.auth.uid == userId;
        }
      }
    }
    match /venues/{venueId} {
      allow read: if true;
      allow write: if true;
    }
    match /plaza/{postId} {
      allow read: if true;
      allow write: if true;
      match /comments/{commentId} {
        allow read: if true;
        allow write: if true;
      }
    }
    match /chat_rooms/{roomId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /chat_messages/{messageId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /events/{eventId} {
      allow read: if true;
      allow write: if true;
      match /registrations/{regId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }
    }
    match /{path=**}/classes/{classId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /{path=**}/monthlyPasses/{passId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /{path=**}/discounts/{discountId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /shops/{shopId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /stay/{stayId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /stays/{stayId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /stay_bookings/{bookingId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /stay_likes/{likeId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /resale/{resaleId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /resale_items/{itemId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /resale_likes/{likeId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /user_reputation/{userId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /lost/{lostId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /arcade/{arcadeId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /socials/{socialId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
      match /reservations/{resId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }
    }
    match /social_likes/{likeId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /galleries/{postId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /gallery_comments/{commentId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /groups/{groupId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
      match /posts/{postId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
        match /comments/{commentId} {
          allow read: if true;
          allow write: if isUserActive(request.auth.uid);
        }
      }
      match /members/{memberId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }
      match /classes/{classId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }
      match /class_registrations/{registrationId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }
      match /monthlyPasses/{passId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }
      match /discounts/{discountId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }

      match /calendar_events/{eventId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }

      match /polls/{pollId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }
    }
    match /feeds/{postId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
      match /comments/{commentId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }
      match /reactions/{reactionId} {
        allow read: if true;
        allow write: if isUserActive(request.auth.uid);
      }
    }
    match /class_registrations/{registrationId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /rental_spaces/{spaceId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /rental_likes/{likeId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /rental_requests/{requestId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /products/{productId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /shop_orders/{orderId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /product_likes/{likeId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /shop_banners/{bannerId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /cartoons/{cartoonId} {
      allow read: if true;
      allow write: if true;
      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if true;
      }
    }
    match /lost_found_items/{itemId} {
      allow read: if true;
      allow create: if isUserActive(request.auth.uid);
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }
    match /lost_found_likes/{likeId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /social_weekly_states/{stateId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /i18n_entries/{entryId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /i18n_meta/{docId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /i18n_versions/{versionId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /people/{personId} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /scenes/{sceneId} {
      allow read: if true;
      allow write: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /antigravity_terminal/{docId} {
      allow read, write: if request.auth != null;
    }
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /user_coupons/{userCouponId} {
      allow read: if true;
      allow write: if isUserActive(request.auth.uid);
    }
    match /error_logs/{logId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    match /coaching_rooms/{roomId} {
      allow read, write: if request.auth != null;
      match /assignments/{assignmentId} {
        allow read, write: if request.auth != null;
      }
      match /feed/{feedId} {
        allow read, write: if request.auth != null;
      }
    }


    match /fysRegistrations/{regId} {
      allow read, write: if true;
    }

    match /culture_contents/{docId} {
      allow read, write: if true;
    }

    match /groupScheduleImages/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // WocClass: 최상위 독립 클래스 객체
    match /classes/{classId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.resource.data.connectedGroupIds.size() == 0 &&
        request.resource.data.createdBy == request.auth.uid && (
          (request.resource.data.organizerType == 'person' && request.resource.data.organizerId == request.auth.uid) ||
          (request.resource.data.organizerType == 'group' && 
           get(/databases/$(database)/documents/groups/$(request.resource.data.organizerId)).data.ownerId == request.auth.uid) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'admin'
        );
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'admin' ||
        (
          (resource.data.createdBy == request.auth.uid || resource.data.organizerId == request.auth.uid) &&
          (request.resource.data.createdBy == resource.data.createdBy) &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['connectedGroupIds'])) &&
          (
            (request.resource.data.organizerType == resource.data.organizerType && request.resource.data.organizerId == resource.data.organizerId) ||
            (request.resource.data.organizerType == 'person' && request.resource.data.organizerId == request.auth.uid) ||
            (request.resource.data.organizerType == 'group' && 
             get(/databases/$(database)/documents/groups/$(request.resource.data.organizerId)).data.ownerId == request.auth.uid)
          )
        ) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['connectedGroupIds', 'updatedAt']) &&
          request.resource.data.connectedGroupIds.size() > 0 &&
          get(/databases/$(database)/documents/groups/$(request.resource.data.connectedGroupIds[request.resource.data.connectedGroupIds.size() - 1])).data.ownerId == request.auth.uid
        )
      );
      allow delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'admin'
      );
    }

    // ClassGroupConnection: 클래스-그룹 연동 관계
    match /classGroupConnections/{connectionId} {
      allow read: if true;
      allow create: if request.auth != null && 
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'SUBMITTED' &&
        (get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.createdBy == request.auth.uid ||
         get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.organizerId == request.auth.uid);
      allow update: if request.auth != null && (
        get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'admin'
      );
      allow delete: if request.auth != null && (
        (resource.data.status == 'SUBMITTED' && resource.data.requestedBy == request.auth.uid) ||
        (resource.data.status == 'SUBMITTED' && 
         get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId == request.auth.uid) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.systemRole == 'admin'
      );
    }

    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true ||
        request.auth.uid == '7iaZAmaYY9dNNEShmJmROI8XrtH2'
      );
    }

    match /activeReportKeys/{keyId} {
      allow read, write: if request.auth != null;
    }
  }
}